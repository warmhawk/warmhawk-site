{
  "name": "warmhawk-site",
  "version": "0.1.0",
  "private": true,
  "description": "WarmHawk marketing/informational site — public, unauthenticated. No product code lives here.",
  "scripts": {
    "dev": "next dev -p 4402",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "generate:og-image": "node scripts/generate-og-image.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "next": "14.2.18",
    "nodemailer": "^6.9.15",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "stripe": "16.12.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.1.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "20.16.11",
    "@types/nodemailer": "^6.4.16",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.1",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.18",
    "jsdom": "^29.1.1",
    "postcss": "8.4.47",
    "prettier": "3.3.3",
    "sharp": "^0.35.3",
    "tailwindcss": "3.4.13",
    "typescript": "5.6.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20"
  }
}
