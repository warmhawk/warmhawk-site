# Copy to .env.local for local dev. Real production values live in
# /opt/warmhawk-site/.env on the deploy target, never committed here — see
# docker-compose.deploy.yml.

# --- Stripe (Phase 4 — Commercial Licensing, Billing & Onboarding) ---
# Secret key for the Checkout Session / Customer Portal / webhook-signature
# verification calls in app/api/checkout, app/api/portal, app/api/stripe.
#
# CI note: the *.test.ts unit suite never reads this (mocked — see lib/stripe.ts's header
# comment). The NEW test:integration / test:human tiers DO make real calls against Stripe's
# TEST-mode API and self-skip cleanly when it's absent — see app/api/checkout/session/
# route.integration.test.ts and app/api/stripe/webhook/route.integration.test.ts. For those tiers
# this must be a real `sk_test_` key (test mode only — never a `sk_live_` key in CI).
STRIPE_SECRET_KEY=

# Signing secret for this endpoint specifically:
# https://warmhawk.com/api/stripe/webhook
#
# CI note: for test:integration / test:human, this is the secret passed as the `secret` param to
# Stripe's own `stripe.webhooks.generateTestHeaderString({ payload, secret })` SDK helper, which
# produces a genuinely valid `stripe-signature` header offline — the integration test then POSTs
# that header through the real route, exercising the real `stripe.webhooks.constructEvent`
# verification path (unlike the mocked route.test.ts). Any real webhook signing secret works; it
# does not need to come from an actual configured Stripe webhook endpoint.
STRIPE_WEBHOOK_SECRET=

# Tier 1 (Self-Hosted Pro) Stripe Price IDs — monthly is the base $199/mo
# price, annual is the second Price on the same Product for the $1,990/yr
# discount (Monetization & Tiering Strategy).
#
# CI note: for test:integration / test:human, these must be real Stripe TEST-mode Price IDs (a
# real Price created against the test-mode WarmHawk product) — the integration test creates a real
# Checkout Session against them.
STRIPE_PRICE_SELF_HOSTED_PRO_MONTHLY=
STRIPE_PRICE_SELF_HOSTED_PRO_ANNUAL=

# Tier 2 (Enterprise DFY) — not sold through this repo's self-serve Checkout
# Session (it's a custom-scoped one-time + retainer engagement), but the
# founder may set the $300/mo retainer up as a Stripe subscription by hand
# against this Price ID so the webhook's tierForPriceId (lib/license.ts)
# recognizes it and issues a tier_2 license instead of defaulting to tier_1.
#
# CI note: real Stripe TEST-mode Price ID for test:integration / test:human, same as the two above.
STRIPE_PRICE_TIER_2=

# --- License issuance (Phase 4) — THIS repo is the sole signing authority.
# See scripts/generate-license-keypair.sh for how to generate a real
# production keypair once, at launch. ---
# PEM-encoded PKCS#8 RSA private key (2048-bit). The matching public key ships
# inside warmhawk-enterprise-operator as LICENSE_PUBLIC_KEY_PEM for
# crypto.createVerify(). Newlines are escaped as literal \n (unescaped by both
# repos' code before use — see lib/license.ts / lib/license/verify.ts).
#
# TEST KEYPAIR — DO NOT USE IN PRODUCTION. Generated once via
# scripts/generate-license-keypair.sh for this repo's own local dev/tests and
# warmhawk-enterprise-operator's matching LICENSE_PUBLIC_KEY_PEM test value,
# so both repos can sign+verify a real token end-to-end without the founder
# generating anything first. Rotated 2026-08-24 (the prior test key had been
# pasted into a chat transcript during an audit — harmless since it was never
# used for anything but local sign/verify round-trips, but rotated on general
# principle rather than assume that). SHA-256 fingerprint of the public half:
