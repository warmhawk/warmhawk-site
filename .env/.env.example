# --- Transactional email (license delivery) — see lib/email.ts. Generic SMTP
# under the hood (nodemailer), pointed at Resend's SMTP relay — chosen
# provider. Resend's SMTP host/port/user are fixed values; SMTP_PASSWORD is
# your Resend API key (create one at resend.com/api-keys with "Sending
# access"). SMTP_FROM's domain must be a domain you've verified in Resend.
# Empty by default: the webhook handler degrades to logging the install
# command instead of failing when SMTP_HOST is unset (never a live send in
# this build). ---
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=
SMTP_FROM="WarmHawk <support@warmhawk.com>"

# RESEND_API_KEY (NEW — test:integration / test:human tiers only) — same value as SMTP_PASSWORD
# above when SMTP_PASSWORD is a real Resend key, but read separately here because these test tiers
# also poll Resend's own REST API (not just SMTP) to confirm the license email actually arrived —
# see tests/integration/resendEmail.ts's waitForResendEmail(). Create at resend.com/api-keys with
# "Sending access". Both this repo's *.integration.test.ts files and tests/human-journeys/ self-skip
# cleanly when this is unset, so it's safe to leave blank until the project owner provisions it as
# a CI secret.
RESEND_API_KEY=

# --- Status page (/status) — a self-hosted Uptime Kuma instance,
# NOT a third-party status SaaS.
# Create two Kuma monitors named exactly "Marketing site" and "Stripe
# webhook / license issuance" (or edit STATUS_COMPONENTS[].label in
# lib/statusProvider.ts to match whatever you name them), add both to one
# public status page, and set its slug below. Both vars are required
# together — /status shows an honest "not configured" state, never a fake
# pass, until both are set (see lib/statusProvider.ts). ---
STATUS_KUMA_BASE_URL=
STATUS_KUMA_SLUG=

# --- Analytics (lib/analytics.ts, components/Analytics.tsx) ---------------
# GA4 measurement ID for the warmhawk.com web stream (G-XXXXXXXXXX). Blank
# disables GA4 entirely — Analytics.tsx injects no tag and track() becomes
# a no-op, which is the correct state for local dev, stage, and every test
# tier (isAutomatedClient() also blocks Playwright traffic even if this is
# set).
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# PostHog project API key (phc_...). Public by design — it identifies the
# project for ingestion and grants no read access. Blank disables PostHog.
NEXT_PUBLIC_POSTHOG_KEY=

# PostHog ingestion host. Must match the region the project was created in:
# https://eu.i.posthog.com or https://us.i.posthog.com. Defaults to EU when
# blank (see lib/analytics.ts) — a mismatch here is silent, the SDK just
# posts to a host that does not know the key.
NEXT_PUBLIC_POSTHOG_HOST=

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://warmhawk.com

# --- Error/trace tracking (should-fix S1 — go-live review) ---------------------------------------
# Same org-wide self-hosted SigNoz collector jitterflow-core-app already sends traces to (see that
# repo's .env/.env.example and ops/otel/tracing.js) — not a new provider. instrumentation.ts's
# register() only loads the OTEL SDK at all when this is set: blank (the default, matches
# jitterflow's own .env.example) means zero overhead, not just "not exporting."
#
# Requires a cross-host nginx route + matching Cloudflare Origin CA cert on the shared edge proxy
# before this can point anywhere real — see otel.jitterflow.io's server block in
# ks-nginx-edge-proxy/saas-production/nginx.conf.template for the pattern to copy
# (certs/jitterflow-shared/ is *.jitterflow.io; warmhawk has no equivalent *.warmhawk.com cert yet).
#OTEL_EXPORTER_OTLP_ENDPOINT=https://otel.warmhawk.com
OTEL_SERVICE_NAME=warmhawk-site

# --- /tools/domain-check (Phase 5 — Free Public Domain-Check Tool) ---
# Public, unauthenticated core-engine endpoint this page's client-side
# fetch calls. Set to the sibling warmhawk-core-engine deployment once it
# exists; the page degrades to an explanatory error state if unset/
# unreachable rather than throwing.
NEXT_PUBLIC_CORE_ENGINE_PUBLIC_API_URL=https://api.warmhawk.com

# --- /vs/instantly gating (Part C judgment call) --------------------------------------------------
# This page's whole argument is "real seed-inbox placement sampling vs Instantly's self-reported
# warmup score." Publishing it before that feature is actually live and verified in production
# would make WarmHawk guilty of exactly the overclaiming this page criticizes Instantly for. Two
# separate flags, BOTH required together, because a value living in this file can never itself
# prove a runtime fact ("is the feature actually confirmed live in prod right now") — the second
# flag exists so a deploy can never enable this page by only setting the first one.
#
# ENABLE_VS_INSTANTLY=true renders the page at all. Unset/false (the default) is a real 404 via
# Next's notFound(), not just hidden from search/nav — see app/vs/instantly/page.tsx.
ENABLE_VS_INSTANTLY=
# SEED_PLACEMENT_LIVE_IN_PRODUCTION=true is the operator's own explicit, by-hand attestation that
# seed-inbox placement sampling is confirmed live in production for real customers — something
# this codebase has no way to verify from a git repo alone. Setting only ONE of these two flags is
# treated as a misconfiguration (loud console.error server-side, an explicit "misconfigured" state
# rendered instead of the real page) rather than silently defaulting to "on" or "off."
SEED_PLACEMENT_LIVE_IN_PRODUCTION=
