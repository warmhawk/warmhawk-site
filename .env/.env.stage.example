# Copy to .env/.env.stage and fill in by hand with REAL values (gitignored — never commit that
# file). Loaded EXCLUSIVELY by scripts/load-env.js when HUMAN_ENV=stage — no merging with, or
# fallback to, .env/.env.local or .env/.env.example. This is for local/dev parity running
# `HUMAN_ENV=stage npm run test:human` against stage.warmhawk.com; it does not change how
# Woodpecker CI injects secrets into the deployed stage server itself (`from_secret` there stays
# authoritative — see ks-woodpecker-config's repo-map.ts). See .env/.env.example for the full,
# repo-wide var list and its per-var comments; this file is the human-journey-stage-scoped subset
# tests/human-journeys/checkout-and-license.spec.ts's real round trip actually depends on.

# --- Stripe (test-mode) — must be REAL Stripe TEST-mode credentials (sk_test_...), matching
# whatever's actually configured on the deployed stage.warmhawk.com server. This suite's checkout
# runs against that already-deployed app (not this local process), so these values must agree with
# stage's own Woodpecker-injected secrets for the real checkout -> webhook -> license round trip to
# complete; they're documented here so a developer running the suite locally can see stage's real
# checkout is backed by the same test-mode Product/Prices, not to inject them into stage itself. ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SELF_HOSTED_PRO_MONTHLY=
STRIPE_PRICE_SELF_HOSTED_PRO_ANNUAL=
STRIPE_PRICE_TIER_2=

# --- Resend — REQUIRED, read directly by this test process (waitForResendEmail polls Resend's own
# REST API for the real license email sent to delivered@resend.dev). Same key as stage's own
# SMTP_PASSWORD when that's a real Resend key; test.skip()'s guard in checkout-and-license.spec.ts
# self-skips the whole journey when this is unset. ---
RESEND_API_KEY=

# --- License signing — REQUIRED, read directly by this test process (verifyLicense() checks the
# emailed token's RSA signature). Must be the SAME private key stage.warmhawk.com's own deployment
# signs with, or verification fails even though the real checkout+email succeeded. Newlines escaped
# as literal \n, same convention as .env/.env.example's own copy of this var. ---
LICENSE_SIGNING_PRIVATE_KEY=
