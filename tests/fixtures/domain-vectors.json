{
  "_comment": "Shared verbatim with warmhawk-site. The two validators are deliberately separate implementations across two trust boundaries; this fixture is what keeps them from drifting. Copy the file, never import across repos.",
  "accepted": [
    {
      "input": "example.com",
      "expected": "example.com",
      "why": "plain"
    },
    {
      "input": "  Example.COM  ",
      "expected": "example.com",
      "why": "trim and lower-case"
    },
    {
      "input": "https://example.com/path?q=1",
      "expected": "example.com",
      "why": "url"
    },
    {
      "input": "http://example.com:8080/",
      "expected": "example.com",
      "why": "url with port"
    },
    {
      "input": "user@example.com",
      "expected": "example.com",
      "why": "email address"
    },
    {
      "input": "example.com.",
      "expected": "example.com",
      "why": "trailing root dot"
    },
    {
      "input": "www.example.com",
      "expected": "example.com",
      "why": "www prefix"
    },
    {
      "input": "sub.domain.example.com",
      "expected": "sub.domain.example.com",
      "why": "deep subdomain"
    },
    {
      "input": "<example.com>",
      "expected": "example.com",
      "why": "wrapping punctuation"
    },
    {
      "input": "example-with-hyphens.com",
      "expected": "example-with-hyphens.com",
      "why": "hyphens"
    },
    {
      "input": "www.example.co.uk",
      "expected": "example.co.uk",
      "why": "www stripped, multi-part TLD preserved"
    },
    {
      "input": "xn--bcher-kva.com",
      "expected": "xn--bcher-kva.com",
      "why": "punycode is already allowlist-safe"
    }
  ],
